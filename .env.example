# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e ajuste os valores conforme necessário.
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
# O arquivo `.env` é ignorado pelo git e NÃO deve ser commitado.
# ---------------------------------------------------------------------------

# Nome do projeto/stack (prefixo de containers, volumes e networks).
COMPOSE_PROJECT_NAME=portainer_stack

# Versão do Portainer CE (use sempre a linha LTS).
# Releases: https://github.com/portainer/portainer/releases
PORTAINER_VERSION=2.39.4

# Porta HTTPS exposta no host para acessar a interface web.
PORTAINER_HTTPS_PORT=9443

# Limite de memória do container (formato Docker: 256M, 512M, 1G...).
PORTAINER_MEMORY_LIMIT=512M
